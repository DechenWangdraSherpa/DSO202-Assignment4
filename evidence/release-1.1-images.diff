diff '--color=auto' -ruN a/backend/src/config.js b/backend/src/config.js
--- a/backend/src/config.js	1970-01-01 05:30:00.000000000 +0530
+++ b/backend/src/config.js	2026-11-20 15:46:28.299610980 +0600
@@ -0,0 +1,28 @@
+// Release 1.1: configuration loading refactored into one module.
+// Every setting is read once at start-up and validated; a missing required
+// setting stops the process with an explicit message instead of failing later.
+const REQUIRED = ['DB_HOST', 'DB_NAME', 'DB_USER', 'DB_PASSWORD', 'DB_SSLMODE'];
+const SSL_MODES = ['disable', 'require'];
+
+function loadConfig() {
+  for (const key of REQUIRED) {
+    if (!process.env[key]) {
+      console.error(`[config] FATAL: required environment variable ${key} is not set (DB_SSLMODE must be one of: ${SSL_MODES.join(', ')})`);
+      process.exit(1);
+    }
+  }
+  if (!SSL_MODES.includes(process.env.DB_SSLMODE)) {
+    console.error(`[config] FATAL: DB_SSLMODE="${process.env.DB_SSLMODE}" is invalid (must be one of: ${SSL_MODES.join(', ')})`);
+    process.exit(1);
+  }
+  return {
+    host: process.env.DB_HOST,
+    port: Number(process.env.DB_PORT) || 5432,
+    database: process.env.DB_NAME,
+    user: process.env.DB_USER,
+    password: process.env.DB_PASSWORD,
+    ssl: process.env.DB_SSLMODE === 'require' ? { rejectUnauthorized: false } : false,
+  };
+}
+
+module.exports = { loadConfig };
